APP_URL=https://my.yildizskylab.com
DATABASE_URL=postgres://account_center:<database-password>@postgres:5432/account_center?sslmode=require
SESSION_SECRET=<generate-with-openssl-rand-base64-48>
TOKEN_ENCRYPTION_KEY=<generate-with-openssl-rand-base64-32>
OIDC_ISSUER=https://e.yildizskylab.com/realms/e-skylab
OIDC_CLIENT_ID=account-center
OIDC_CLIENT_SECRET=<keycloak-confidential-client-secret>
# Account REST oturum işlemleri bu kullanıcı token'ını kullanır; Admin API/service-account secret'ı eklenmez.
OIDC_UPSTREAM_SESSION_MAX_SECONDS=<verified-keycloak-session-max-seconds>
AUTH_TRUSTED_PROXY=cloudflare
NATIVE_BRIDGE_HMAC_SECRET=<generate-with-openssl-rand-base64-32>
NATIVE_BRIDGE_MTLS_CLIENT_SHA256=<lowercase-sha256-of-keycloak-client-certificate>
ACCOUNT_ACCESS_GATE_MODE=enforce
ACCOUNT_ACCESS_REDIS_HOST=<dedicated-access-gate-redis-host>
ACCOUNT_ACCESS_REDIS_PORT=6379
ACCOUNT_ACCESS_REDIS_USERNAME=<account-center-read-only-user>
ACCOUNT_ACCESS_REDIS_PASSWORD=<dedicated-access-gate-redis-password>
ACCOUNT_ACCESS_REDIS_DATABASE=0
ACCOUNT_ACCESS_REDIS_TLS=true
ACCOUNT_ACCESS_REDIS_TLS_SERVER_NAME=<dedicated-access-gate-redis-host>
# Salt okunur secret mount'ları; özel anahtarı environment içine koyma.
ACCOUNT_ACCESS_REDIS_CA_CERT_FILE=/run/secrets/account-access/ca.crt
ACCOUNT_ACCESS_REDIS_TLS_CERT_FILE=/run/secrets/account-access/account-center.crt
ACCOUNT_ACCESS_REDIS_TLS_KEY_FILE=/run/secrets/account-access/account-center.key
ACCOUNT_ACCESS_REDIS_OPERATION_TIMEOUT_MS=200
# Hesap silme rollout kapıları tamamlanana kadar kapalı kalır.
ACCOUNT_ERASURE_MODE=off
# Kulüp profili (core /v1/users/me) ve ACCOUNT_ERASURE_MODE=enforce için canonical Core origin.
# Tanımsızsa kulüp profili özellikleri kapalı kalır; tanımlıysa credential'sız HTTPS origin olmak zorundadır.
# CORE_API_URL=https://api.yildizskylab.com
# Profil fotoğraflarının yayımlandığı origin; CSP img-src yalnız bunu ek olarak tanır.
# Tanımsızsa https://cdn.yildizskylab.com kullanılır; tanımlıysa credential'sız HTTPS origin olmak zorundadır.
# PROFILE_PICTURE_ORIGIN=https://cdn.yildizskylab.com
# YTÜ Microsoft identity provider'ının Keycloak alias'ı; "YTÜ hesabımı bağla" yalnız bu alias için
# kc_action=idp_link ister. Tanımsızsa OBS; tanımlıysa 1-64 karakter [A-Za-z0-9_-] olmak zorundadır.
# YTU_IDP_ALIAS=OBS
PORT=3000
HOSTNAME=0.0.0.0
