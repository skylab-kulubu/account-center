APP_URL=https://my.yildizskylab.com
DATABASE_URL=postgres://account_center:<database-password>@postgres:5432/account_center?sslmode=require
SESSION_SECRET=<generate-with-openssl-rand-base64-48>
TOKEN_ENCRYPTION_KEY=<generate-with-openssl-rand-base64-32>
OIDC_ISSUER=https://e.yildizskylab.com/realms/e-skylab
OIDC_CLIENT_ID=account-center
OIDC_CLIENT_SECRET=<keycloak-confidential-client-secret>
OIDC_UPSTREAM_SESSION_MAX_SECONDS=<verified-keycloak-session-max-seconds>
AUTH_TRUSTED_PROXY=cloudflare
NATIVE_BRIDGE_HMAC_SECRET=<generate-with-openssl-rand-base64-32>
NATIVE_BRIDGE_MTLS_CLIENT_SHA256=<lowercase-sha256-of-keycloak-client-certificate>
ACCOUNT_ACCESS_GATE_MODE=enforce
ACCOUNT_ACCESS_REDIS_HOST=<dedicated-access-gate-redis-host>
ACCOUNT_ACCESS_REDIS_PORT=6379
ACCOUNT_ACCESS_REDIS_USERNAME=<account-center-read-only-user>
ACCOUNT_ACCESS_REDIS_PASSWORD=<dedicated-access-gate-redis-password>
ACCOUNT_ACCESS_REDIS_DATABASE=0
ACCOUNT_ACCESS_REDIS_TLS=true
ACCOUNT_ACCESS_REDIS_TLS_SERVER_NAME=<dedicated-access-gate-redis-host>
# Optional only when the Redis certificate is signed by a private CA.
ACCOUNT_ACCESS_REDIS_TLS_CA_BASE64=
ACCOUNT_ACCESS_REDIS_OPERATION_TIMEOUT_MS=200
PORT=3000
HOSTNAME=0.0.0.0
